# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secrète — jamais côté client, seulement dans les Route Handlers serveur
SUPABASE_SERVICE_ROLE_KEY=

# CinetPay — Dashboard marchand CinetPay
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# OTP téléphone — Supabase Send SMS Hook (Authentication > Hooks) + API Orange SMS CI
# (remplace Twilio : ~7 FCFA/SMS vs ~290 FCFA/SMS vers la Côte d'Ivoire)
SEND_SMS_HOOK_SECRET=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_NUMBER=

# Email client automatique (changement de statut de commande) — API HTTP Brevo,
# PAS la clé SMTP déjà utilisée pour les emails Supabase Auth (Brevo distingue
# "clés SMTP" et "clés API" dans Réglages > SMTP & API : en générer une nouvelle).
# Expéditeur : n'importe quelle adresse sur un domaine déjà authentifié dans
# Brevo (agnissanisaac.com pour l'instant, ex: commandes@agnissanisaac.com).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# URL publique du site — utilisée côté serveur (Server Actions) pour construire
# des liens absolus dans les emails, là où window.location n'existe pas.
NEXT_PUBLIC_SITE_URL=https://boutique-iota-hazel.vercel.app
