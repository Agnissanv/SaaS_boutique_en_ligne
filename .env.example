# Supabase — Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secrète — jamais côté client, seulement dans les Route Handlers serveur
SUPABASE_SERVICE_ROLE_KEY=

# Nyole — agrégateur de paiement (voir src/lib/nyole.ts pour le détail
# complet). Remplace CinetPay en totalité le 28/09/2026 : compte Nyole
# d'Isaac vérifié, pas de liste blanche d'IP à demander (contrairement à
# CinetPay), donc pas de relais à déployer.
# Clé secrète live, trouvable dans l'espace Nyole d'Isaac sous "API et
# journaux" (commence par af_live_sec_...).
NYOLE_SECRET_KEY=
# Coupe-circuit optionnel : mettre à "false" pour masquer proprement le
# paiement en ligne en cas d'incident, sans déploiement. "true" (ou variable
# absente) par défaut. Voir isNyolePaymentsEnabled() dans src/lib/nyole.ts.
NYOLE_PAYMENTS_ENABLED=true

# OTP téléphone — Supabase Send SMS Hook (Authentication > Hooks) + API Orange SMS CI
# (remplace Twilio : ~7 FCFA/SMS vs ~290 FCFA/SMS vers la Côte d'Ivoire)
SEND_SMS_HOOK_SECRET=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_NUMBER=

# Email client automatique (changement de statut de commande) — API HTTP Brevo,
# PAS la clé SMTP déjà utilisée pour les emails Supabase Auth (Brevo distingue
# "clés SMTP" et "clés API" dans Réglages > SMTP & API : en générer une nouvelle).
# Expéditeur : n'importe quelle adresse sur un domaine déjà authentifié dans
# Brevo (agnissanisaac.com pour l'instant, ex: commandes@agnissanisaac.com).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Notifications push (Web Push API) — 01/10/2026, voir migration 0052 et
# src/lib/push/send-push.ts. Gratuit, aucun compte/service tiers : une simple
# paire de clés VAPID auto-générée pour authentifier KEVA auprès des services
# de push des navigateurs (Chrome/Firefox/Edge — Apple Push pour Safari/iOS
# utilise le même protocole Web Push depuis iOS 16.4, à condition que le
# vendeur ait installé KEVA sur son écran d'accueil : limite d'iOS, pas de
# KEVA). Déjà générées une fois par Claude (voir .env.local, jamais commité) —
# à régénérer toi-même si tu préfères (`npx web-push generate-vapid-keys`) :
# dans ce cas, mets à jour aussi le trigger SQL dans la migration 0052
# (même valeur que VAPID_PRIVATE_KEY n'est PAS nécessaire là-bas, seul
# PUSH_INTERNAL_SECRET y est recopié en dur).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Exposée au navigateur (nécessaire pour `pushManager.subscribe`) — c'est la
# clé PUBLIQUE, sans risque à exposer comme son nom l'indique.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Email de contact que les services de push (Chrome, Firefox...) peuvent
# utiliser pour contacter KEVA en cas d'abus détecté sur l'envoi de push —
# format "mailto:adresse@domaine".
VAPID_SUBJECT=mailto:contact@shopkeva.com
# Secret partagé entre le trigger pg_net (migration 0052) et la route
# /api/push/trigger — empêche un tiers de déclencher l'envoi de push pour un
# notification_id arbitraire. Même principe que SEND_SMS_HOOK_SECRET
# ci-dessus. Depuis le 09/10/2026 (migration 0058), le trigger lit la même
# valeur dans Supabase Vault (secret nommé `push_internal_secret`) — plus
# jamais en dur dans une migration. Si tu le régénères, mets à jour les deux
# côtés (Vault + cette variable sur Vercel). Générer : `openssl rand -hex 32`.
PUSH_INTERNAL_SECRET=

# Captcha anti-robot du tunnel de commande — Cloudflare Turnstile (gratuit),
# 09/10/2026, voir migrations 0059/0060 et src/components/turnstile-widget.tsx.
# À créer sur dash.cloudflare.com > Turnstile > Add widget (domaine
# shopkeva.com, mode "Managed"). La clé publique (site key) est inscrite dans
# le code au build : après l'avoir ajoutée/modifiée sur Vercel, REDÉPLOYER.
# Sans ces deux variables, le widget n'apparaît pas et les commandes passent
# sans captcha — tant que la migration 0060 n'est pas appliquée.
# En local, clés de test publiques de Cloudflare (valident toujours) :
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secret des tâches planifiées Vercel (vercel.json : expiration des
# abonnements, purge des vieux messages). Vercel l'envoie automatiquement en
# `Authorization: Bearer <CRON_SECRET>` à chaque exécution ; les routes
# /api/cron/* refusent (401) tout appel sans lui. S'IL MANQUE SUR VERCEL, LES
# CRONS NE FONT RIEN : les abonnements n'expirent jamais. Générer :
# `openssl rand -hex 32`, à mettre dans Vercel > Settings > Environment
# Variables (Production).
CRON_SECRET=

# URL publique du site — utilisée côté serveur (Server Actions, sitemap.ts,
# metadataBase) pour construire des liens absolus, là où window.location
# n'existe pas. Mis à jour le 21/09/2026 : nom de domaine de lancement acheté
# chez Spaceship. À reporter dans les réglages Production du projet Vercel
# UNE FOIS le domaine effectivement connecté (DNS pointé vers Vercel + domaine
# personnalisé ajouté au projet) — sinon les liens absolus (emails, aperçus
# WhatsApp/réseaux sociaux, sitemap.xml) continueront de pointer vers l'ancienne
# URL *.vercel.app tant que cette variable n'est pas changée là-bas.
NEXT_PUBLIC_SITE_URL=https://shopkeva.com
