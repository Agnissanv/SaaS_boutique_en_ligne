"use client";

import Link from "next/link";
import { useEffect, useState } from "react";
import { ProductImage } from "@/components/product-image";
import type { MarketplaceCardProduct } from "@/components/product-card";

const ROTATE_MS = 4500;

/**
 * Carrousel du hero — remplace le nuage de photos (hero-photo-cloud.tsx,
 * supprimé) le 29/09/2026, à la demande d'Isaac : "et si on mettait une
 * bannière ou plusieurs au hero", avec un mix décidé de bannières "devenir
 * vendeur" et de vraies vitrines produit plutôt qu'un choix exclusif entre
 * les deux.
 *
 * Les deux bannières vendeur reprennent mot pour mot des accroches déjà
 * validées dans claude/affiches-et-posts-lancement.md (Affiche 3 "0%
 * commission cachée", Affiche 2 "Ta boutique. 5 minutes.") — aucun nouveau
 * texte marketing inventé ici. L'argument marge (0% commission) passe en
 * premier : diagnostic du 29/09/2026 sur les 9 premières boutiques
 * (decisions-techniques.md) — le profil "jeune revendeur", sensible à la
 * commission, devient la cible payante prioritaire ; "5 minutes, gratuit"
 * reste secondaire (argument d'activation, jamais un prix affiché).
 *
 * Les bannières produit reprennent le motif déjà validé de
 * HeroFeaturedSlideshow (photo + carte prix flottante) pour rester cohérent
 * visuellement plutôt que d'inventer un second style de carte dans le même
 * hero.
 *
 * Contrairement aux diaporamas déco du hero (HeroFeaturedSlideshow /
 * HeroMobileSlideshow, sans contrôle manuel), ces diapositives portent un
 * vrai CTA : flèches + points cliquables, et pause au survol/focus — on ne
 * veut jamais qu'une bannière "Ouvre ta boutique" défile sous la souris de
 * quelqu'un qui est justement en train de la lire.
 *
 * `prefers-reduced-motion` : pas de rotation automatique, la première
 * diapositive reste affichée ; la navigation manuelle reste disponible.
 */

type VendorSlide = {
  kind: "vendor";
  id: string;
  kicker: string;
  title: string;
  subtitle: string;
  ctaLabel: string;
  href: string;
};

type ProductSlide = {
  kind: "product";
  id: string;
  product: MarketplaceCardProduct;
};

type Slide = VendorSlide | ProductSlide;

const VENDOR_SLIDES: VendorSlide[] = [
  {
    kind: "vendor",
    id: "vendor-marge",
    kicker: "Deviens vendeur",
    title: "0% commission cachée",
    subtitle: "Ton lien, tes prix, ta marge reste à toi.",
    ctaLabel: "Ouvrir ma boutique",
    href: "/inscription",
  },
  {
    kind: "vendor",
    id: "vendor-5min",
    kicker: "Démarre gratuitement",
    title: "Ta boutique en 5 minutes",
    subtitle: "Sans carte bancaire, sans engagement.",
    ctaLabel: "Créer ma boutique",
    href: "/inscription",
  },
];

// Alterne vendeur/produit plutôt que de les grouper — évite d'avoir "toutes
// les bannières vendeur d'abord, puis tous les produits", qui se lirait
// comme deux carrousels recollés bout à bout.
function buildSlides(productSlides: MarketplaceCardProduct[]): Slide[] {
  const products: Slide[] = productSlides.map((p) => ({
    kind: "product",
    id: p.id,
    product: p,
  }));

  const slides: Slide[] = [];
  const maxLen = Math.max(VENDOR_SLIDES.length, products.length);
  for (let i = 0; i < maxLen; i++) {
    if (VENDOR_SLIDES[i]) slides.push(VENDOR_SLIDES[i]);
    if (products[i]) slides.push(products[i]);
  }
  return slides;
}

export function HeroBannerCarousel({
  productSlides,
}: {
  productSlides: MarketplaceCardProduct[];
}) {
  const slides = buildSlides(productSlides);
  const [index, setIndex] = useState(0);
  const [paused, setPaused] = useState(false);

  useEffect(() => {
    if (slides.length <= 1 || paused) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const id = setInterval(() => {
      setIndex((i) => (i + 1) % slides.length);
    }, ROTATE_MS);
    return () => clearInterval(id);
  }, [slides.length, paused]);

  if (slides.length === 0) return null;

  // `slides` peut changer de longueur d'un chargement à l'autre (nouveaux
  // produits) — jamais un index hors bornes si la liste a rétréci entre deux
  // rendus.
  const safeIndex = index % slides.length;
  const current = slides[safeIndex];
  const goTo = (i: number) => setIndex((i + slides.length) % slides.length);

  return (
    <div
      className="relative hidden h-96 w-80 shrink-0 overflow-hidden rounded-2xl shadow-[0_18px_36px_rgba(14,59,44,0.16)] sm:block lg:h-[26rem] lg:w-[22rem]"
      onMouseEnter={() => setPaused(true)}
      onMouseLeave={() => setPaused(false)}
      onFocus={() => setPaused(true)}
      onBlur={() => setPaused(false)}
    >
      {current.kind === "vendor" ? (
        <Link
          href={current.href}
          className="group flex h-full w-full flex-col justify-between bg-gradient-to-br from-vert-sapin to-vert-actif px-6 py-8 transition hover:brightness-105"
        >
          <p className="text-[11px] font-bold uppercase tracking-[0.22em] text-ivoire/80">
            {current.kicker}
          </p>
          <div>
            <p className="font-display text-2xl font-black leading-tight text-white lg:text-3xl">
              {current.title}
            </p>
            <p className="mt-2 text-sm text-ivoire/80">{current.subtitle}</p>
            <span className="mt-5 inline-flex items-center gap-2 rounded-lg bg-white px-5 py-2.5 text-sm font-semibold text-vert-sapin transition group-hover:bg-brume">
              {current.ctaLabel}
              <span aria-hidden="true">→</span>
            </span>
          </div>
        </Link>
      ) : (
        <Link
          href={`/${current.product.shopSlug}/${current.product.slug}`}
          className="group relative block h-full w-full"
        >
          <ProductImage
            src={current.product.thumbnail}
            alt={current.product.title}
            className="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
          />
          <div className="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-vert-profond/80 to-transparent" />
          <div className="absolute bottom-5 left-5 right-5 rounded-xl bg-white px-4 py-3 shadow-[0_14px_30px_rgba(14,59,44,0.22)]">
            <p className="line-clamp-1 text-xs text-encre/60">{current.product.title}</p>
            <p className="font-mono text-base font-semibold text-vert-actif">
              {current.product.price.toLocaleString("fr-FR")} FCFA
            </p>
          </div>
        </Link>
      )}

      {slides.length > 1 ? (
        <>
          <button
            type="button"
            onClick={() => goTo(safeIndex - 1)}
            aria-label="Bannière précédente"
            className="absolute left-3 top-1/2 z-10 -translate-y-1/2 rounded-full bg-vert-profond/35 p-2 text-white backdrop-blur-sm transition hover:bg-vert-profond/55 active:scale-90"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="M10 3 5 8l5 5"
                stroke="currentColor"
                strokeWidth="1.6"
                strokeLinecap="round"
                strokeLinejoin="round"
              />
            </svg>
          </button>
          <button
            type="button"
            onClick={() => goTo(safeIndex + 1)}
            aria-label="Bannière suivante"
            className="absolute right-3 top-1/2 z-10 -translate-y-1/2 rounded-full bg-vert-profond/35 p-2 text-white backdrop-blur-sm transition hover:bg-vert-profond/55 active:scale-90"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path
                d="m6 3 5 5-5 5"
                stroke="currentColor"
                strokeWidth="1.6"
                strokeLinecap="round"
                strokeLinejoin="round"
              />
            </svg>
          </button>

          <div className="absolute right-3 top-3 z-10 flex items-center gap-1.5">
            {slides.map((s, i) => (
              <button
                key={s.id}
                type="button"
                aria-current={i === safeIndex}
                aria-label={`Aller à la bannière ${i + 1}`}
                onClick={() => goTo(i)}
                className={`h-1.5 rounded-full transition-all ${
                  i === safeIndex ? "w-5 bg-white" : "w-1.5 bg-white/45"
                }`}
              />
            ))}
          </div>
        </>
      ) : null}
    </div>
  );
}
